# Không commit file .env thật lên Git.

# Embedding và ChromaDB
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_DEVICE=cpu
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_EMBED_BATCH_SIZE=8
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.45
HF_HUB_DISABLE_XET=1
HF_HUB_DOWNLOAD_TIMEOUT=120

# Vector store. Dùng embedded cho máy phát triển, http khi chạy ChromaDB online.
RAG_CHROMA_MODE=http
RAG_CHROMA_HOST=localhost
RAG_CHROMA_PORT=8000
RAG_CHROMA_SSL=false
# Header xác thực tùy chọn cho reverse proxy/Chroma server, dạng JSON string.
RAG_CHROMA_HEADERS_JSON=

# Kết nối Odoo của RAG worker. Tạo API key cho một tài khoản worker
# thuộc nhóm Settings; không dùng mật khẩu và không commit file .env thật.
ODOO_URL=http://127.0.0.1:1818
ODOO_DATABASE=odoo18_ai_demo
ODOO_LOGIN=admin
ODOO_API_KEY=
RAG_WORKER_INTERVAL=3
RAG_WORKER_BATCH_SIZE=10

# Có thể đổi cache sang thư mục riêng trên ổ D.
# RAG_MODEL_CACHE_DIR=D:\AI_Cache\huggingface
# RAG_CHROMA_DIR=D:\AI_Cache\chroma_odoo_agent

# LLM sinh câu trả lời. Mặc định dùng Ollama miễn phí trên máy local.
LLM_PROVIDER=ollama
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_MAX_TOKENS=1200
LLM_ENABLE_THINKING=false

# Để dùng NVIDIA Build, đặt LLM_PROVIDER=nvidia, URL/model tương ứng và
# điền API key thật vào file .env. Không bao giờ commit API key lên Git.
# LLM_PROVIDER=nvidia
# LLM_API_KEY=nvapi-REPLACE_ME
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
