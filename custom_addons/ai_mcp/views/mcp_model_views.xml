<odoo>
    <record id="view_ai_mcp_model_list" model="ir.ui.view">
        <field name="name">ai.mcp.model.list</field>
        <field name="model">ai.mcp.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="model_name"/>
                <field name="description"/>
                <field name="deny_field_ids" widget="many2many_tags"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_ai_mcp_model_form" model="ir.ui.view">
        <field name="name">ai.mcp.model.form</field>
        <field name="model">ai.mcp.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="model_id" options="{'no_create': True}"/>
                        <field name="active"/>
                        <field name="description"/>
                        <field name="deny_field_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ai_mcp_model" model="ir.actions.act_window">
        <field name="name">MCP Models</field>
        <field name="res_model">ai.mcp.model</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <menuitem id="menu_ai_mcp_model" name="MCP Models"
              parent="base.menu_administration" action="action_ai_mcp_model"
              groups="base.group_system" sequence="91"/>
</odoo>
