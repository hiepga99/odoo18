<odoo>
    <record id="view_server_action_form_mcp" model="ir.ui.view">
        <field name="name">ir.actions.server.form.mcp</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="mcp"><field name="used_in_mcp"/></group>
            </xpath>
        </field>
    </record>
</odoo>
